---
// The one dashboard. Private working page — password-gated at the edge,
// noindex, not in the sitemap, linked from /admin.
//
// Everything it shows is read from committed files at build time: no fetch, no
// CORS, no backend. A job commits a record, Netlify rebuilds, this updates
// itself. The queue is read from seo-engine/queue.md rather than duplicated
// here, so the page can never disagree with the file.
import BaseLayout from '../layouts/BaseLayout.astro';
import BackendNav from '../components/BackendNav.astro';
import history from '../../seo-engine/history.json';
import state from '../../seo-engine/state.json';
import review from '../../seo-engine/review.json';
import transcripts from '../../seo-engine/transcripts/index.json';
import queueRaw from '../../seo-engine/queue.md?raw';
import { parseQueue, inlineMarkdown } from '../../seo-engine/queue-parser.mjs';

const queue = parseQueue(queueRaw);

const records = [...(history.records ?? [])].sort((a, b) => a.date.localeCompare(b.date));
const latest = records[records.length - 1] ?? null;
const prev = records.length > 1 ? records[records.length - 2] : null;

const delta = (a, b) => (a == null || b == null) ? null : a - b;
const mentionsDelta = prev ? delta(latest?.ai?.mentions, prev.ai?.mentions) : null;
const pagesDelta = prev ? delta(latest?.indexedPages, prev.indexedPages) : null;

const keywords = [...(latest?.keywords ?? [])]
  .filter(k => k.searchVolume)
  .sort((a, b) => (b.searchVolume ?? 0) - (a.searchVolume ?? 0));
const totalVolume = keywords.reduce((s, k) => s + (k.searchVolume ?? 0), 0);
// What this traffic would cost to buy, if we ranked and took a ~30% click share.
const trafficValue = keywords.reduce((s, k) => s + ((k.searchVolume ?? 0) * 0.3 * (k.cpc ?? 0)), 0);

const openReviews = review.open ?? [];
const cycles = state.moves_run ?? [];

// Transcripts that exist are answers waiting to be rewritten from what David
// actually said — the highest-value content move available.
const readyTranscripts = (transcripts.entries ?? []).filter(e => e.status === 'ok');
const failedTranscripts = (transcripts.entries ?? []).filter(e => e.status !== 'ok');

// "Your move" = anything actually actionable now.
const nowItems = queue.now.filter(i => i.status !== 'done');
const openCount = openReviews.length + nowItems.length;

function spark(values, w = 260, h = 44) {
  if (values.length < 2) return null;
  const max = Math.max(...values, 1);
  const step = w / (values.length - 1);
  return values.map((v, i) => `${(i * step).toFixed(1)},${(h - (v / max) * h).toFixed(1)}`).join(' ');
}
const mentionSpark = spark(records.map(r => r.ai?.mentions ?? 0));
const fmt = n => n == null ? '—' : n.toLocaleString('en-US');

const statusStyle = s =>
  s === 'doing'     ? 'bg-gold/25 text-bg-dark'
  : s === 'blocked' ? 'bg-gray-200 text-gray-600'
  : s === 'done'    ? 'bg-green-100 text-green-800'
  : 'bg-bg-dark text-white';
---

<BaseLayout title="Dashboard" description="Private operations dashboard for alot.land." noindex={true} bare={true}>
  <BackendNav current="seo" />
  <div class="bg-bg-dark text-white py-10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-widest text-gold mb-2">alot.land · private</p>
      <h1 class="font-display font-black text-3xl sm:text-4xl mb-2">Dashboard</h1>
      <p class="text-gray-400">
        {openCount === 0
          ? <>Nothing needs you right now.</>
          : <><strong class="text-white">{openCount}</strong> {openCount === 1 ? 'thing needs' : 'things need'} you.</>}
        {latest && <> · Last measured {latest.date} · updates every Monday.</>}
      </p>
      <nav class="flex flex-wrap gap-2 mt-6">
        <a href="#your-move" class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-gold text-bg-dark">Your move</a>
        <a href="#numbers" class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 transition-colors">Numbers</a>
        <a href="#keywords" class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 transition-colors">Keywords</a>
        <a href="#later" class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 transition-colors">Later</a>
        <a href="#history" class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 transition-colors">History</a>
        <a href="/handbook/" class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 transition-colors">Handbook</a>
      </nav>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <h2 id="your-move" class="font-display font-black text-2xl text-bg-dark mb-1">Your move</h2>
    <p class="text-gray-500 text-sm mb-5">Everything waiting on you. Nothing else on this page needs action.</p>

    {openCount === 0 && readyTranscripts.length === 0 && (
      <div class="rounded-2xl border border-gray-200 bg-white p-8 text-center mb-8">
        <p class="text-gray-600">Nothing outstanding. The next cycle runs Monday.</p>
      </div>
    )}

    {openReviews.length > 0 && (
      <div class="rounded-2xl border-2 border-gold bg-gold/10 p-6 mb-4">
        <p class="text-xs font-bold uppercase tracking-widest text-bg-dark mb-2">
          {openReviews.length === 1 ? 'Waiting for your approval' : `${openReviews.length} waiting for your approval`}
        </p>
        <p class="text-gray-700 text-sm mb-4">Nothing here is live. Open it, read it, then <strong>merge to publish</strong> or <strong>close to discard</strong>. A cycle pull request left open stops the next one from running.</p>
        <ul class="space-y-2">
          {openReviews.map(pr => (
            <li>
              <a href={pr.url} target="_blank" rel="noopener"
                 class="flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-xl bg-white px-4 py-3 hover:bg-white/70 transition-colors">
                <span class="font-semibold text-bg-dark">{pr.title}</span>
                {pr.isCycle && <span class="text-[10px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-bg-dark text-gold">cycle</span>}
                <span class="text-xs text-gray-500 tabular-nums">#{pr.number} · opened {pr.opened}</span>
                {pr.additions != null && (
                  <span class="text-xs tabular-nums text-gray-400">+{pr.additions} / −{pr.deletions}</span>
                )}
                <span class="ml-auto text-sm font-bold text-bg-dark">Review →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {readyTranscripts.length > 0 && (
      <div class="rounded-2xl border border-gray-200 bg-white p-6 mb-4">
        <p class="text-xs font-bold uppercase tracking-widest text-text-muted mb-2">
          {readyTranscripts.length} transcript{readyTranscripts.length === 1 ? '' : 's'} pulled
        </p>
        <p class="text-gray-700 text-sm mb-4">Your videos were transcribed automatically. The next cycle rewrites these answers from what you actually said — that is the material that gets quoted, because it exists nowhere else.</p>
        <ul class="flex flex-wrap gap-2">
          {readyTranscripts.map(t => (
            <li class="text-xs bg-gray-50 rounded-lg px-3 py-2">
              <span class="font-semibold text-bg-dark">{t.question ?? t.slug}</span>
              <span class="text-gray-400 tabular-nums"> · {t.words} words · {t.captions}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {failedTranscripts.length > 0 && (
      <div class="rounded-xl border border-red-300 bg-red-50 p-4 mb-4 text-sm text-red-800">
        <strong>{failedTranscripts.length} transcript{failedTranscripts.length === 1 ? '' : 's'} could not be pulled.</strong>
        Usually the video is private, unlisted with captions off, or still processing.
        <ul class="mt-2 list-disc pl-5">
          {failedTranscripts.map(t => (<li>{t.question ?? t.slug} — {t.error ?? t.status}</li>))}
        </ul>
      </div>
    )}

    {nowItems.length > 0 && (
      <ol class="space-y-3">
        {nowItems.map(i => (
          <li class="rounded-2xl border border-gray-200 bg-white p-5">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${statusStyle(i.status)}`}>{i.status || 'todo'}</span>
              <span class="text-xs text-text-muted font-semibold">{i.owner}</span>
            </div>
            <p class="text-bg-dark font-semibold leading-snug" set:html={inlineMarkdown(i.item)} />
            {i.why && <p class="text-gray-500 text-sm mt-2 leading-relaxed" set:html={inlineMarkdown(i.why)} />}
          </li>
        ))}
      </ol>
    )}

    <p class="text-xs text-gray-400 mt-4">
      This list is <code class="bg-gray-100 px-1 rounded">seo-engine/queue.md</code>. Editing that file
      changes this page — tick something off by moving its row to <strong>Done</strong>.
    </p>

    <h2 id="numbers" class="font-display font-black text-2xl text-bg-dark mt-12 mb-4">Numbers</h2>

    {!latest && (
      <div class="rounded-2xl border border-gray-200 bg-white p-8 text-center">
        <p class="text-gray-600">The weekly job has not run yet. It collects the first record on Monday.</p>
      </div>
    )}

    {latest && (
      <>
        <div class="grid sm:grid-cols-3 gap-4">
          <div class="rounded-2xl border border-gray-200 bg-white p-6">
            <p class="text-xs font-bold uppercase tracking-widest text-text-muted mb-2">AI mentions (US)</p>
            <p class="font-display font-black text-4xl text-bg-dark tabular-nums">{fmt(latest.ai?.mentions)}</p>
            <p class="text-sm mt-2">
              {mentionsDelta == null ? <span class="text-gray-400">baseline</span>
                : mentionsDelta > 0 ? <span class="text-green-brand font-semibold">+{mentionsDelta} since last week</span>
                : mentionsDelta < 0 ? <span class="text-red-600 font-semibold">{mentionsDelta} since last week</span>
                : <span class="text-gray-400">no change</span>}
            </p>
            {mentionSpark && (
              <svg viewBox="0 0 260 44" class="w-full h-11 mt-3" aria-hidden="true">
                <polyline points={mentionSpark} fill="none" stroke="#F5B800" stroke-width="2" stroke-linejoin="round" />
              </svg>
            )}
          </div>

          <div class="rounded-2xl border border-gray-200 bg-white p-6">
            <p class="text-xs font-bold uppercase tracking-widest text-text-muted mb-2">Pages indexed</p>
            <p class="font-display font-black text-4xl text-bg-dark tabular-nums">{fmt(latest.indexedPages)}</p>
            <p class="text-sm mt-2">
              {pagesDelta == null ? <span class="text-gray-400">baseline</span>
                : pagesDelta === 0 ? <span class="text-gray-400">no change</span>
                : <span class="text-green-brand font-semibold">+{pagesDelta} since last week</span>}
            </p>
            <p class="text-xs text-gray-400 mt-3">Unexplained growth here is a warning sign, not a win — it means pages are being published faster than intended.</p>
          </div>

          <div class="rounded-2xl border border-gray-200 bg-white p-6">
            <p class="text-xs font-bold uppercase tracking-widest text-text-muted mb-2">Traffic value / mo</p>
            <p class="font-display font-black text-4xl text-bg-dark tabular-nums">${Math.round(trafficValue).toLocaleString('en-US')}</p>
            <p class="text-sm text-gray-500 mt-2">If we ranked for the tracked set</p>
            <p class="text-xs text-gray-400 mt-3">{fmt(totalVolume)} searches a month across {keywords.length} keywords, priced at their ad cost.</p>
          </div>
        </div>

        <div class={`mt-4 rounded-xl border p-4 text-sm ${latest.control?.healthy ? 'border-gray-200 bg-white text-gray-600' : 'border-red-300 bg-red-50 text-red-800'}`}>
          {latest.control?.healthy
            ? <>✅ <strong>Measurement is trustworthy.</strong> The control domain ({latest.control.domain}) returned {fmt(latest.control.mentions)} mentions in the same run, so a zero above is real rather than a broken call.</>
            : <>⚠️ <strong>Treat this run as suspect.</strong> The control domain returned zero too, which means the API or the parser failed — not that the site is invisible.</>}
        </div>

        <h2 id="keywords" class="font-display font-black text-2xl text-bg-dark mt-12 mb-1">Tracked keywords</h2>
        <p class="text-gray-500 text-sm mb-4">Difficulty runs 0–100. Anything at 0 with real volume is an opening — it means nobody has answered it properly.</p>
        <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-text-muted border-b border-gray-100">
                <th class="py-3 px-4 font-semibold">Keyword</th>
                <th class="py-3 px-4 font-semibold text-right">Searches/mo</th>
                <th class="py-3 px-4 font-semibold text-right">Difficulty</th>
                <th class="py-3 px-4 font-semibold text-right">Cost per click</th>
              </tr>
            </thead>
            <tbody>
              {keywords.map(k => (
                <tr class="border-b border-gray-50 last:border-0">
                  <td class="py-3 px-4 text-bg-dark">{k.keyword}</td>
                  <td class="py-3 px-4 text-right tabular-nums font-semibold">{fmt(k.searchVolume)}</td>
                  <td class="py-3 px-4 text-right">
                    <span class={`inline-block px-2 py-0.5 rounded-full text-xs font-bold tabular-nums ${
                      k.difficulty == null ? 'bg-gray-100 text-gray-400'
                      : k.difficulty <= 10 ? 'bg-green-100 text-green-800'
                      : k.difficulty <= 30 ? 'bg-yellow-100 text-yellow-800'
                      : 'bg-red-100 text-red-800'}`}>
                      {k.difficulty ?? '—'}
                    </span>
                  </td>
                  <td class="py-3 px-4 text-right tabular-nums text-gray-500">{k.cpc ? `$${k.cpc.toFixed(2)}` : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}

    <h2 id="later" class="font-display font-black text-2xl text-bg-dark mt-12 mb-1">Later</h2>
    <p class="text-gray-500 text-sm mb-4">Queued but not urgent. Here so nothing gets lost, not so you act on it now.</p>
    <div class="grid md:grid-cols-2 gap-4">
      <div class="rounded-2xl border border-gray-200 bg-white p-6">
        <h3 class="font-display font-bold text-lg text-bg-dark mb-3">Next up</h3>
        <ul class="space-y-3">
          {queue.next.map(i => (
            <li class="text-sm">
              <p class="text-bg-dark font-medium leading-snug" set:html={inlineMarkdown(i.item)} />
              <p class="text-xs text-gray-400 mt-0.5">{i.owner}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-6">
        <h3 class="font-display font-bold text-lg text-bg-dark mb-3">Blocked</h3>
        <ul class="space-y-3">
          {queue.blocked.map(i => (
            <li class="text-sm">
              <p class="text-bg-dark font-medium leading-snug" set:html={inlineMarkdown(i.item)} />
              <p class="text-xs text-gray-400 mt-0.5">waiting on {i.blockedBy || '—'}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <h2 id="history" class="font-display font-black text-2xl text-bg-dark mt-12 mb-4">History</h2>
    <div class="grid md:grid-cols-2 gap-4">
      <div class="rounded-2xl border border-gray-200 bg-white p-6">
        <h3 class="font-display font-bold text-lg text-bg-dark mb-3">Cycles run</h3>
        <ul class="space-y-3">
          {cycles.map(c => (
            <li class="text-sm">
              <span class="font-bold text-bg-dark">Cycle {c.cycle}</span>
              <span class="text-gray-400"> · {c.date}</span>
              {c.new_pages > 0 && <span class="ml-2 inline-block px-2 py-0.5 rounded-full bg-gold/20 text-xs font-bold text-bg-dark">+{c.new_pages} page</span>}
              <p class="text-gray-600 mt-0.5">{c.move}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-gray-200 bg-white p-6">
        <h3 class="font-display font-bold text-lg text-bg-dark mb-3">Shipped</h3>
        <ul class="space-y-1.5">
          {queue.done.slice().reverse().map(d => (
            <li class="text-sm text-gray-600 flex gap-2">
              <span class="text-green-brand font-bold">✓</span>
              <span set:html={inlineMarkdown(d.item)} />
            </li>
          ))}
        </ul>
      </div>
    </div>

    {records.length > 0 && (
      <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white mt-4">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-text-muted border-b border-gray-100">
              <th class="py-3 px-4 font-semibold">Measured</th>
              <th class="py-3 px-4 font-semibold text-right">AI mentions</th>
              <th class="py-3 px-4 font-semibold text-right">Pages</th>
              <th class="py-3 px-4 font-semibold text-right">Control</th>
              <th class="py-3 px-4 font-semibold text-right">API cost</th>
            </tr>
          </thead>
          <tbody>
            {[...records].reverse().map(r => (
              <tr class="border-b border-gray-50 last:border-0">
                <td class="py-3 px-4 tabular-nums">{r.date}</td>
                <td class="py-3 px-4 text-right tabular-nums font-semibold">{fmt(r.ai?.mentions)}</td>
                <td class="py-3 px-4 text-right tabular-nums">{fmt(r.indexedPages)}</td>
                <td class="py-3 px-4 text-right tabular-nums text-gray-500">{fmt(r.control?.mentions)}</td>
                <td class="py-3 px-4 text-right tabular-nums text-gray-500">${r.apiCostUsd?.toFixed(2) ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    {records.length < 4 && (
      <p class="text-sm text-gray-500 mt-3">A trend needs a few weeks of records. Expect flat numbers at first — that is normal, and it is exactly when people quit.</p>
    )}

    <p class="text-xs text-gray-400 mt-8">
      Built from <code class="bg-gray-100 px-1 rounded">seo-engine/</code> — queue, metrics, review status and
      transcripts, all committed to the repo. Nothing here is fetched at page load.
      How it all works: <a href="/handbook/" class="underline">the handbook</a>.
    </p>
  </div>
</BaseLayout>
