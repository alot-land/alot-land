---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingGallery from '../../components/ListingGallery.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import AmenitySlideshow from '../../components/AmenitySlideshow.astro';
import VendorSection from '../../components/VendorSection.astro';
import { getCollection, render, getEntry } from 'astro:content';
import { siteConfig } from '../../config/site.js';

export async function getStaticPaths() {
  const listings = await getCollection('listings');
  return listings.map(listing => ({
    params: { slug: listing.slug },
    props: { listing },
  }));
}

const { listing } = Astro.props;
const { Content } = await render(listing);
const { title, status, acreage, county, state, price, address, showAddress, zoning, roadAccess, water, power, gps, videoUrl, showVideo, zillowUrl, showZillow, showSellerFinance, photos, amenityPhotos, date, dateSold, showDaysOnMarket, buyerTestimonial, buyerName } = listing.data;

const loc = `${county} County, ${state}`;
const pricePart = price ? ` — ${price}` : '';
// Short form for the <title> only — BaseLayout appends " | alot.land", and
// Google truncates around 60 chars. Full state name stays in the description.
const stateAbbr: Record<string, string> = { Tennessee: 'TN', Arizona: 'AZ' };
const locShort = `${county} County, ${stateAbbr[state] ?? state}`;

// If this lot belongs to a community that has a sales page (Button Link set),
// show a banner linking back to it — so QR visitors can reach the full pitch.
const community = listing.data.community
  ? await getEntry('communities', listing.data.community)
  : null;
const communityBackUrl = community?.data.ctaUrl ?? '';
const communityName = community?.data.title ?? '';

// Status-aware title (matches the share-image stamp). "for Sale" only when truly
// available (best for SEO). Price is omitted here — it's already in the meta
// description — so titles stay under Google's ~60-char truncation point.
const pageTitle =
  status === 'available'      ? `${acreage} Acres for Sale | ${locShort}` :
  status === 'coming-soon'    ? `${acreage} Acres — Coming Soon | ${locShort}` :
  status === 'under-contract' ? `${acreage} Acres — Under Contract | ${locShort}` :
                                `${acreage} Acres — SOLD | ${locShort}`;

const bodyText = listing.body.replace(/[#*_`[\]()>~]/g, '').replace(/\s+/g, ' ').trim();

// Status-aware description opener so it never contradicts the title/stamp
const descLead =
  status === 'available'      ? `${acreage} acres of land for sale in ${loc}` :
  status === 'coming-soon'    ? `${acreage} acres in ${loc} — coming soon` :
  status === 'under-contract' ? `${acreage} acres in ${loc} — under contract` :
                                `${acreage} acres in ${loc} — sold`;
const descPrice = status === 'sold' ? '' : (price ? `. Asking ${price}` : '');
const pageDescription = `${descLead}${descPrice}. ${bodyText}`.slice(0, 155);
const canonicalUrl = `https://${siteConfig.domain}/listings/${listing.slug}`;
// Social-share image: the listing's first photo with the status stamped on it
// (generated at build by src/pages/og/[slug].jpg.ts). The ?v=<status> tag busts
// social-platform image caches when a listing's status changes.
const ogImage = `/og/${listing.slug}.jpg?v=${status}`;

// Days on Market: only calculated when both dates exist and toggle is on
let daysOnMarket: number | undefined;
if (showDaysOnMarket && date) {
  const end = dateSold ?? new Date();
  daysOnMarket = Math.round((end.getTime() - date.getTime()) / (1000 * 60 * 60 * 24));
}

const details = [
  { label: 'Address', value: (showAddress ? address : undefined) },
  { label: 'Acreage', value: `${acreage} acres` },
  { label: 'Price', value: price || 'Contact for Price' },
  { label: 'Days on Market', value: daysOnMarket !== undefined ? `${daysOnMarket} days` : undefined },
  { label: 'County', value: county },
  { label: 'State', value: state },
  { label: 'Zoning', value: zoning },
  { label: 'Road Access', value: roadAccess },
  { label: 'Water', value: water },
  { label: 'Power/Utilities', value: power },
];

let mapsUrl: string | undefined;
if (gps) {
  const [lat, lng] = gps.split(',').map(s => s.trim());
  mapsUrl = `https://maps.google.com/?q=${lat},${lng}`;
}

// ── Structured data for this listing ─────────────────────────────────────────
const siteOrigin = `https://${siteConfig.domain}`;
const priceNumeric = price ? Number(price.replace(/[^0-9.]/g, '')) || undefined : undefined;
const schemaAvailability =
  status === 'available'      ? 'https://schema.org/InStock'  :
  status === 'coming-soon'    ? 'https://schema.org/PreOrder' :
  status === 'under-contract' ? 'https://schema.org/LimitedAvailability' :
                                'https://schema.org/SoldOut';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',     item: siteOrigin },
    { '@type': 'ListItem', position: 2, name: 'Listings', item: `${siteOrigin}/listings` },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
  ],
};

const listingSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: title,
  description: pageDescription,
  image: photos.map(p => p.startsWith('http') ? p : `${siteOrigin}${p}`),
  url: canonicalUrl,
  brand: { '@id': 'https://alot.land/#organization' },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    ...(priceNumeric ? { price: priceNumeric } : { priceSpecification: { '@type': 'UnitPriceSpecification', description: 'Contact for Price' } }),
    availability: schemaAvailability,
    url: canonicalUrl,
    seller: { '@id': 'https://alot.land/#organization' },
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Acreage',     value: `${acreage} acres` },
    { '@type': 'PropertyValue', name: 'County',      value: county },
    { '@type': 'PropertyValue', name: 'State',       value: state },
    ...(zoning     ? [{ '@type': 'PropertyValue', name: 'Zoning',      value: zoning }]     : []),
    ...(roadAccess ? [{ '@type': 'PropertyValue', name: 'Road Access', value: roadAccess }] : []),
    ...(water      ? [{ '@type': 'PropertyValue', name: 'Water',       value: water }]      : []),
    ...(power      ? [{ '@type': 'PropertyValue', name: 'Utilities',   value: power }]      : []),
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  ogImageWidth={1200}
  ogImageHeight={630}
  ogType="article"
  noChat={true}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(listingSchema)} />

  {communityBackUrl && (
    <a
      href={communityBackUrl}
      target="_blank"
      rel="noopener"
      class="stv-banner group sticky top-16 z-40 block overflow-hidden bg-gold text-bg-dark hover:bg-yellow-400 transition-colors border-b border-bg-dark/10"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-center gap-2 text-sm font-semibold text-center">
        <span aria-hidden="true">📍</span>
        <span>
          Part of <span class="font-bold underline decoration-bg-dark/40 underline-offset-2">{communityName}</span> — see all the lots and information on the area here
        </span>
        <span aria-hidden="true" class="stv-arrow inline-block">→</span>
      </div>
    </a>
  )}

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Back link: community lots return to their community page; everything else to all listings -->
    <a href={community ? `/communities/${listing.data.community}` : "/listings"} class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-bg-dark transition-colors mb-6">
      ← {community ? `Back to ${communityName}` : "All Listings"}
    </a>

    <!-- Status badge + Title + Heart -->
    <div class="flex items-start gap-4 flex-wrap mb-6">
      <span class={`text-sm font-bold px-3 py-1.5 rounded-full flex-shrink-0 ${
        status === 'available' ? 'bg-green-brand text-white' :
        status === 'coming-soon' ? 'bg-blue-500 text-white' :
        status === 'under-contract' ? 'bg-yellow-400 text-bg-dark' :
        'bg-gray-400 text-white'
      }`}>
        {status === 'available' ? 'Available' : status === 'coming-soon' ? 'Coming Soon' : status === 'under-contract' ? '🟡 Under Contract' : '🔴 Sold'}
      </span>
      <h1 class="font-display font-black text-3xl sm:text-4xl text-bg-dark leading-tight flex-1">
        {title}
      </h1>
      <button
        class="heart-btn w-11 h-11 flex items-center justify-center rounded-full bg-white border border-gray-200 shadow-sm hover:shadow-md transition-shadow flex-shrink-0"
        data-slug={listing.slug}
        data-title={title}
        aria-label="Save to favorites"
      >
        <svg class="heart-icon w-5 h-5 transition-colors" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </button>
    </div>

    <!-- Quick-action bar: price + CTAs, above the fold -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3 mb-8 pb-6 border-b border-gray-100">
      <div class="flex items-baseline gap-3">
        <span class="text-2xl font-display font-black text-gold">{price || 'Contact for Price'}</span>
        <span class="text-text-muted text-sm">{acreage} acres · {county} County, {state}</span>
      </div>
      <div class="flex flex-wrap gap-2 sm:ml-auto">
        <a href="#inquire" class="bg-gold text-bg-dark text-sm font-bold px-5 py-2.5 rounded-xl hover:bg-yellow-400 transition-colors">
          Request Info
        </a>
        {showSellerFinance && (
          <button id="sf-open" class="border border-bg-dark text-bg-dark text-sm font-bold px-5 py-2.5 rounded-xl hover:bg-gray-50 transition-colors">
            💵 Estimate Payment
          </button>
        )}
        <a href={`tel:${siteConfig.phoneRaw}`} class="border border-bg-dark text-bg-dark text-sm font-bold px-5 py-2.5 rounded-xl hover:bg-gray-50 transition-colors">
          📞 Call
        </a>
      </div>
    </div>

    <div class="grid lg:grid-cols-3 gap-10">
      <!-- Main content -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Gallery -->
        <ListingGallery photos={photos} title={title} />

        <!-- Video -->
        {showVideo !== false && videoUrl && (
          <div>
            <h2 class="font-display font-bold text-xl text-bg-dark mb-4">Property Video</h2>
            <VideoEmbed url={videoUrl} title={title} />
          </div>
        )}

        <!-- Description -->
        <div class="prose prose-gray max-w-none">
          <h2 class="font-display font-bold text-xl text-bg-dark mb-4">About This Property</h2>
          <Content />
        </div>

        <!-- Share -->
        <ShareButtons title={title} url={canonicalUrl} price={price} acreage={acreage} state={state} />
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Property Details -->
        <div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-sm">
          <h2 class="font-display font-bold text-xl text-bg-dark mb-5">Property Details</h2>
          <dl class="space-y-3">
            {details.filter(d => d.value).map(d => (
              <div class="flex justify-between text-sm gap-4">
                <dt class="text-text-muted font-medium flex-shrink-0">{d.label}</dt>
                <dd class={`text-right font-semibold ${d.label === 'Price' ? 'text-gold' : 'text-bg-dark'}`}>
                  {d.value}
                </dd>
              </div>
            ))}
            {gps && (
              <div class="flex justify-between text-sm gap-4">
                <dt class="text-text-muted font-medium flex-shrink-0">GPS</dt>
                <dd class="text-right">
                  {mapsUrl ? (
                    <a
                      href={mapsUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-gold font-semibold hover:underline"
                    >
                      {gps} ↗
                    </a>
                  ) : (
                    <span class="font-semibold text-bg-dark">{gps}</span>
                  )}
                </dd>
              </div>
            )}
          </dl>

          <!-- Zillow Link -->
          {showZillow && zillowUrl && (
            <div class="mt-5">
              <a
                href={zillowUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 w-full border-2 border-[#006AFF] text-[#006AFF] font-bold py-2.5 rounded-xl hover:bg-[#006AFF] hover:text-white transition-colors text-sm"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 flex-shrink-0">
                  <path d="M12 2L2 9.5V22h7v-7h6v7h7V9.5L12 2z"/>
                </svg>
                View on Zillow ↗
              </a>
            </div>
          )}

        </div>

        <!-- Inquiry Form -->
        <div id="inquire" class="bg-white rounded-2xl border border-gray-100 p-6 shadow-sm scroll-mt-24">
          <h3 class="font-display font-bold text-lg text-bg-dark mb-2">Inquire About This Property</h3>
          <iframe
            src={`https://brand.alot.land/widget/form/f9D0fKTeKcjbc5H0aCab?single_line_7lu6=${encodeURIComponent(title)}`}
            style="width:100%;height:941px;border:none;border-radius:8px"
            id="inline-f9D0fKTeKcjbc5H0aCab"
            data-layout="{'id':'INLINE'}"
            data-trigger-type="alwaysShow"
            data-trigger-value=""
            data-activation-type="alwaysActivated"
            data-activation-value=""
            data-deactivation-type="neverDeactivate"
            data-deactivation-value=""
            data-form-name="Property Inquiry"
            data-height="941"
            data-layout-iframe-id="inline-f9D0fKTeKcjbc5H0aCab"
            data-form-id="f9D0fKTeKcjbc5H0aCab"
            title="Property Inquiry"
          ></iframe>
          <script src="https://brand.alot.land/js/form_embed.js"></script>
        </div>

        <!-- Buyer Testimonial (sold listings) -->
        {buyerTestimonial && (
          <div class="bg-bg-dark text-white rounded-2xl p-6">
            <div class="text-gold text-4xl font-serif leading-none mb-3 select-none">&ldquo;</div>
            <p class="text-gray-300 text-sm leading-relaxed mb-4">{buyerTestimonial}</p>
            <div class="flex items-center gap-3 pt-3 border-t border-white/10">
              <div class="w-8 h-8 rounded-full bg-gold flex items-center justify-center font-display font-black text-bg-dark text-sm flex-shrink-0">
                {buyerName ? buyerName.charAt(0) : '★'}
              </div>
              <p class="text-white font-semibold text-sm">{buyerName || 'Verified Buyer'}</p>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Amenity Slideshow — full width below the property grid -->
  {amenityPhotos && amenityPhotos.length > 0 && (
    <AmenitySlideshow photos={amenityPhotos} heading={`What's Near ${title}`} />
  )}

  <!-- Preferred Vendors for this property's state -->
  <VendorSection state={state} heading="Preferred Vendors for This Property" />

  {showSellerFinance && (
    <div id="sf-modal" class="hidden fixed inset-0 z-[60] items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
      <div class="bg-white rounded-2xl w-full max-w-2xl max-h-[92vh] overflow-hidden relative shadow-2xl">
        <button id="sf-close" aria-label="Close calculator" class="absolute top-2 right-3 text-gray-400 hover:text-bg-dark text-2xl leading-none z-10">✕</button>
        <iframe id="sf-frame" title="Seller-Finance Calculator" data-src={`/land-payment-calculator?price=${priceNumeric || ''}&lot=${listing.slug}`} style="width:100%;height:88vh;border:0"></iframe>
      </div>
    </div>
    <script is:inline>
      (function(){
        var openBtn=document.getElementById('sf-open'), modal=document.getElementById('sf-modal'),
            closeBtn=document.getElementById('sf-close'), frame=document.getElementById('sf-frame');
        if(!openBtn||!modal) return;
        function show(){ if(!frame.src) frame.src=frame.dataset.src; modal.classList.remove('hidden'); modal.classList.add('flex'); document.body.style.overflow='hidden'; }
        function hide(){ modal.classList.add('hidden'); modal.classList.remove('flex'); document.body.style.overflow=''; }
        openBtn.addEventListener('click', show);
        closeBtn.addEventListener('click', hide);
        modal.addEventListener('click', function(e){ if(e.target===modal) hide(); });
        document.addEventListener('keydown', function(e){ if(e.key==='Escape') hide(); });
      })();
    </script>
  )}
</BaseLayout>

<style>
  /* Micro-animation for the community banner: a slow shine sweep across the gold,
     plus a gentle arrow nudge — both disabled for reduced-motion users. */
  .stv-banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 42%, rgba(255,255,255,.28) 50%, transparent 58%);
    transform: translateX(-100%);
    animation: stv-shine 9s ease-in-out infinite;
    pointer-events: none;
  }
  .stv-arrow { animation: stv-nudge 1.6s ease-in-out infinite; }
  @keyframes stv-shine { 0%, 72% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
  @keyframes stv-nudge { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(4px); } }
  @media (prefers-reduced-motion: reduce) {
    .stv-banner::after, .stv-arrow { animation: none; }
  }
</style>

